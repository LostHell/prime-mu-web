# Database connection string (used by Prisma CLI)
DATABASE_URL=mysql://user:password@host:3306/MuOnline97

# Database connection parameters (used by Prisma adapter)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_NAME=MuOnline97

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=secret

# Trust reverse-proxy/deployment host headers for Auth.js URL validation
AUTH_TRUST_HOST=true

# IANA game-server timezone for event schedules (UTC unless configured).
NEXT_PUBLIC_GAME_TIME_ZONE=UTC

# Game server address used to show the online/offline status.
GAME_SERVER_HOST=127.0.0.1
GAME_SERVER_PORT=55901

# Public origin for canonical URLs, the sitemap, and Open Graph images.
# Set this before building and running the site. Unset uses http://localhost:3000.
SITE_URL=http://localhost:3000

# The game launcher's release folder: the update files (patches/) and the launchers (launcher/)
# that the client's publish.cmd makes. In production a Docker volume (Coolify: Storages), e.g.
# /data/launcher. Unset: no updates and no launcher to download.
LAUNCHER_FILES_DIR=

# The release upload (publish.cmd --upload). Its secret token (generate with: openssl rand -hex 32);
# unset turns the upload off. And the publisher's public key (64 hex characters, the client's
# publisher-public.key) that every uploaded manifest must be signed with.
LAUNCHER_UPLOAD_TOKEN=
LAUNCHER_PUBLIC_KEY=
